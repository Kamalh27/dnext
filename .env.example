# GCP (set when project is created)
PROJECT_ID=
REGION=asia-southeast1
EE_PROJECT=
# Local dev only: path to a service-account JSON key (relative to repo root, or absolute). Leave empty to use ADC.
EE_SERVICE_ACCOUNT_KEY=      # e.g. credentials/ee-sa.json
# Sign in (Firebase Authentication, Google provider) + per-account limits. Create the values in the Firebase console:
# add Firebase to your GCP project, Authentication > Sign-in method > Google, then Project settings > Your apps > Web app (config below).
# Authorised domains: localhost and the deployed web host. AUTH_REQUIRED=false leaves everything open (local dev).
AUTH_REQUIRED=false
FIREBASE_API_KEY=            # public web config values, not secrets
FIREBASE_AUTH_DOMAIN=        # <project>.firebaseapp.com
FIREBASE_APP_ID=
# FIREBASE_PROJECT_ID defaults to PROJECT_ID
GEO_BACKEND=mock            # mock | ee
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
AGENT_MODEL=gemini-3.5-flash
BRIEFING_MODEL=gemini-3.5-flash
ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=
NEXT_PUBLIC_FEEDBACK_FORM_URL=      # Google Form link; empty shows a 'not available' notice
