# GCP (set when project is created)
PROJECT_ID=
REGION=asia-southeast1
EE_PROJECT=
# Local dev only: path to a service-account JSON key (relative to repo root, or absolute). Leave empty to use ADC.
EE_SERVICE_ACCOUNT_KEY=      # e.g. credentials/ee-sa.json
# Sign in with Google + per-account limits (production). Create a Web OAuth client at APIs & Services > Credentials;
# authorised JavaScript origins: http://localhost:3000 and your deployed web URL. AUTH_REQUIRED=false leaves everything open (local dev).
AUTH_REQUIRED=false
GOOGLE_OAUTH_CLIENT_ID=
SESSION_SECRET=              # any long random string locally; Secret Manager in production
GEO_BACKEND=mock            # mock | ee
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
AGENT_MODEL=gemini-3.5-flash
BRIEFING_MODEL=gemini-3.5-flash
ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=
NEXT_PUBLIC_FEEDBACK_FORM_URL=      # Google Form link; empty shows a 'not available' notice
